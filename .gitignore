# Local secrets — never commit
config/keys.local.php
config/db.local.php
.env
.env.*

# One-shot ops tools (upload to server manually, never commit)
db-doctor.php

# Runtime / generated
cache/*
!cache/.htaccess
uploads/videos/*
uploads/creatives/*
uploads/avatars/*
uploads/tickets/*
uploads/invoices/*
uploads/marketplace/*
uploads/dating/*
!uploads/**/.htaccess

# Local artifacts of this build (spec snapshots, scratch dumps) stay out
# Database SQL — ALLOWED per project decision: installer SQL ships in the repo
# (idempotent CREATE TABLE IF NOT EXISTS / INSERT IGNORE / guarded ALTERs).
# Only scratch/temp artifacts of this build stay out.
database/_tmp_*
_tmp_*.sql
database/adsbooster/
adsbooster_upgrade/

# Dependencies
vendor/

